<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D">

    <!-- 상단 대시보드 (점수, 연쇄, Next Puyo) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#111827"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="점수: 0"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연쇄: 0"
                android:textColor="#F59E0B"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 다음 나올 뿌요 (Next Puyo Preview) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1E293B"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivNextSub"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/presence_online" />

            <ImageView
                android:id="@+id/ivNextMain"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/presence_online" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRestart"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:text="재시작"
            android:textSize="12sp"
            android:backgroundTint="#DC2626"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- 중앙 커스텀 게임 뷰 (6x12 Puyo Grid) -->
    <com.example.puyopuyo.GameView
        android:id="@+id/gameView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomController"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 하단 모바일 버추얼 컨트롤러 (Virtual Pad) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomController"
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:background="#111827"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- D-PAD 방향키 영역 (좌측) -->
        <LinearLayout
            android:id="@+id/dpadArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="16dp">

            <ImageButton
                android:id="@+id/btnLeft"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@android:drawable/btn_default"
                android:backgroundTint="#1E293B"
                android:src="@android:drawable/arrow_down_float"
                android:rotation="90"
                android:contentDescription="왼쪽 이동" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="6dp">

                <ImageButton
                    android:id="@+id/btnDown"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@android:drawable/btn_default"
                    android:backgroundTint="#1E293B"
                    android:src="@android:drawable/arrow_down_float"
                    android:contentDescription="아래 소프트 드롭" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnRight"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@android:drawable/btn_default"
                android:backgroundTint="#1E293B"
                android:src="@android:drawable/arrow_down_float"
                android:rotation="270"
                android:contentDescription="오른쪽 이동" />
        </LinearLayout>

        <!-- 버튼 영역 (우측: 회전 및 하드드롭) -->
        <LinearLayout
            android:id="@+id/actionArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="16dp">

            <ImageButton
                android:id="@+id/btnRotateCCW"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@android:drawable/btn_default"
                android:backgroundTint="#334155"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="반시계 회전" />

            <ImageButton
                android:id="@+id/btnRotateCW"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="10dp"
                android:background="@android:drawable/btn_default"
                android:backgroundTint="#2563EB"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="시계방향 회전" />

            <Button
                android:id="@+id/btnHardDrop"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="8dp"
                android:text="즉시\n낙하"
                android:textSize="11sp"
                android:backgroundTint="#D97706"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
